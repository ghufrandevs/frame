# Copy this file to ".env" and fill in real values. Never commit .env.

# ===== Database (SQL Server) =====
# Must be 8+ chars with uppercase, lowercase, number and symbol. Avoid ";" (breaks the connection string).
DB_PASSWORD=ChangeMe_Strong1!
DB_PORT=1434

# ===== Email (Mailpit) =====
MAIL_UI_PORT=8025
MAIL_SMTP_PORT=1025

# ===== API =====
API_PORT=8080
# Development keeps Swagger on for the demo; Production hides it.
API_ENVIRONMENT=Development
# At least 32 characters, random. Generate one; never reuse a key that was shared anywhere.
JWT_KEY=
ADMIN_EMAIL=admin@gmail.om
ADMIN_PASSWORD=
ADMIN_FULLNAME=Frame Admin

# ===== Websites (nginx) =====
# 4200 and 4201 are already allowed by the API's CORS defaults.
WEB_PORT=4200
ADMIN_PORT=4201